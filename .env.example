# ============================================================================
# WhatsApp News Chat Scraper
# ============================================================================
CHAT_NAME="צ'אט הכתבים N12"
CHAT_ID=""
HEADLESS=false

MAX_RETRIES=3
RETRY_DELAY=30000

LOG_LEVEL="info"

# ============================================================================
# Google Sheets (shared by the scraper and the video digest)
# ============================================================================
GOOGLE_SHEET_ID=""
GOOGLE_CREDENTIALS_PATH="./credentials.json"

# ============================================================================
# Video Digest — send a YouTube/Instagram link, get a summarized, indexed record
# ============================================================================

# --- Required ---------------------------------------------------------------
# Anthropic API key, used for summaries and for answering questions.
# Never commit a real key: keep it in .env, which is gitignored.
ANTHROPIC_API_KEY=""

# Spreadsheet for the video digest. Defaults to GOOGLE_SHEET_ID when unset.
# Leave both empty to archive locally only.
VIDEO_SHEET_ID=""
VIDEO_SHEET_VIDEOS_TAB="Videos"
VIDEO_SHEET_TOPICS_TAB="Topics"

# --- Toolchain --------------------------------------------------------------
# yt-dlp is required. ffmpeg is only needed for the ASR fallback.
YTDLP_PATH="yt-dlp"

# Some Instagram content needs a logged-in session. Set ONE of these, or neither.
# Browser name, e.g. "chrome", "firefox", "safari", "edge".
YTDLP_COOKIES_FROM_BROWSER=""
# Or a Netscape-format cookies file. Treat it as a credential — never commit it.
YTDLP_COOKIES_FILE=""

# --- Transcription ----------------------------------------------------------
# Subtitle languages to try, in order of preference.
VIDEO_SUBTITLE_LANGS="he,en,iw,en-US,en-GB"

# ASR fallback, used only when a video has no captions at all.
VIDEO_ASR_ENABLED="true"
VIDEO_ASR_COMMAND="whisper"
VIDEO_ASR_MODEL="small"
# Force a language (e.g. "he") instead of letting the engine detect it.
VIDEO_ASR_LANGUAGE=""
# Refuse to transcribe videos longer than this. 5400s = 90 minutes.
MAX_ASR_DURATION_SEC=5400

# --- Summarization ----------------------------------------------------------
VIDEO_SUMMARY_MODEL="claude-opus-5"
VIDEO_SUMMARY_MAX_TOKENS=16000
# low | medium | high | xhigh | max — higher costs more and reasons harder.
VIDEO_SUMMARY_EFFORT="medium"
# Language for the generated summaries.
VIDEO_SUMMARY_LANGUAGE="Hebrew"
# Transcripts longer than this are capped before summarization (never silently).
VIDEO_MAX_TRANSCRIPT_CHARS=400000

# --- GitHub enrichment ------------------------------------------------------
# Read-only metadata lookups for repos mentioned in a video.
VIDEO_GITHUB_ENRICH="true"
# Optional. A token only raises the rate limit; no scopes are needed.
GITHUB_TOKEN=""
VIDEO_MAX_REPOS=15

# --- Storage ----------------------------------------------------------------
VIDEO_ARCHIVE_DIR="./data/archive"

# --- WhatsApp watcher -------------------------------------------------------
# Chat to listen on for links. Defaults to CHAT_ID when unset.
VIDEO_WATCH_CHAT_ID=""
# Whether the watcher replies in the chat with the summary.
VIDEO_WATCH_REPLY="true"

# --- Resource limits (raise only if you hit them) ---------------------------
VIDEO_TOOL_TIMEOUT_MS=120000
VIDEO_AUDIO_TIMEOUT_MS=600000
VIDEO_MAX_AUDIO_MB=200
VIDEO_MAX_SUBTITLE_BYTES=8388608
VIDEO_GITHUB_TIMEOUT_MS=15000
