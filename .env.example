# WhatsApp Configuration
CHAT_NAME="צ'אט הכתבים N12"
CHAT_ID=""
HEADLESS=false

# Scraping Configuration
MAX_RETRIES=3
RETRY_DELAY=30000

# Logging Configuration
LOG_LEVEL="info"

# ============================================================
# Content Factory (automated faceless channel)
# See content-factory/README.md for the full setup guide.
# ============================================================

# Channel identity
CHANNEL_NAME="My Channel"
CHANNEL_NICHE="interesting facts and stories"
CHANNEL_LANGUAGE="English"
CHANNEL_TONE="energetic, curious, hook-driven"
TARGET_DURATION_SEC=45

# Required: script generation + growth advisor
ANTHROPIC_API_KEY=

# Required: one TTS provider (elevenlabs preferred if both set)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
OPENAI_API_KEY=

# Recommended: stock footage (free key at pexels.com/api)
PEXELS_API_KEY=

# YouTube (run: node content-factory/cli.js auth-youtube for the refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Instagram Reels (Business account + Meta app; Cloudinary hosts the video file)
IG_ACCESS_TOKEN=
IG_USER_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# TikTok (Content Posting API; SELF_ONLY until your app is approved)
TT_ACCESS_TOKEN=
# TT_PRIVACY_LEVEL=SELF_ONLY
